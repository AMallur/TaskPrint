{
  "$defs": {
    "Event": {
      "additionalProperties": false,
      "description": "One meaningful action or observation in a completed task.",
      "properties": {
        "actor": {
          "default": "human",
          "maxLength": 200,
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "kind": {
          "$ref": "#/$defs/EventKind",
          "default": "action"
        },
        "target": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        },
        "type": {
          "description": "Stable semantic action name",
          "maxLength": 200,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "type"
      ],
      "title": "Event",
      "type": "object"
    },
    "EventKind": {
      "enum": [
        "observe",
        "input",
        "action",
        "decision",
        "output",
        "human"
      ],
      "title": "EventKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A successful or failed example of a task being performed.",
  "properties": {
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "maxItems": 100000,
      "minItems": 1,
      "title": "Events",
      "type": "array"
    },
    "id": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "labels": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Labels",
      "type": "object"
    },
    "outcome": {
      "additionalProperties": true,
      "title": "Outcome",
      "type": "object"
    },
    "schema_version": {
      "const": "taskprint-trace/1.0",
      "default": "taskprint-trace/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "success": {
      "default": true,
      "title": "Success",
      "type": "boolean"
    },
    "task": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Task",
      "type": "string"
    }
  },
  "required": [
    "id",
    "task",
    "events"
  ],
  "title": "Trace",
  "type": "object"
}
